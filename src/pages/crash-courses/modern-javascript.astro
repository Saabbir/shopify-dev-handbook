---
import CourseLayout from '../../layouts/CourseLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const chapters = [
  { id: 'what-is-modern-js', title: 'What "modern JavaScript" means' },
  { id: 'let-const-scope', title: 'let, const & block scope' },
  { id: 'arrow-functions', title: 'Arrow functions' },
  { id: 'template-literals', title: 'Template literals' },
  { id: 'destructuring-defaults', title: 'Destructuring & defaults' },
  { id: 'spread-rest', title: 'Spread & rest' },
  { id: 'modules', title: 'Modules: import & export' },
  { id: 'promises-async', title: 'Promises & async/await' },
  { id: 'classes-and-friends', title: 'Classes, ?. and ??' },
  { id: 'array-object-utilities', title: 'Array & object utilities' },
  { id: 'string-number-niceties', title: 'String & number niceties' },
  { id: 'more-promise-tools', title: 'More Promise tools' },
  { id: 'small-syntax-sugar', title: 'Small syntax sugar' },
  { id: 'brand-new', title: 'Brand-new — check first' },
];

const es5VsModern = `// ES5 — the way JavaScript looked for over a decade
var prices = [12, 8, 25, 4];
var cheap = [];
for (var i = 0; i < prices.length; i++) {
  if (prices[i] < 15) {
    cheap.push(prices[i]);
  }
}
console.log(cheap); // [12, 8, 4]

// The same thing, written in modern JavaScript (ES6+)
const prices2 = [12, 8, 25, 4];
const cheap2 = prices2.filter((price) => price < 15);
console.log(cheap2); // [12, 8, 4]`;

const varLoopBug = `// The classic var-in-a-loop bug
for (var i = 0; i < 3; i++) {
  setTimeout(() => console.log(i), 0);
}
// Prints: 3, 3, 3 — not 0, 1, 2!
// Every callback shares the SAME "i", because var isn't scoped to the loop body.`;

const letLoopFix = `// Same loop, with let instead of var
for (let i = 0; i < 3; i++) {
  setTimeout(() => console.log(i), 0);
}
// Prints: 0, 1, 2 — each turn of the loop gets its own "i".`;

const constNotFrozen = `const note = { productId: "123", body: "Restock next week" };

note.body = "Restock next week — supplier confirmed"; // fine, mutating a field
note.priority = "high"; // fine, adding a field

note = { productId: "456", body: "Different note" };
// TypeError: Assignment to constant variable.
// const locks the BINDING (the name "note"), not the object's contents.`;

const regularFnThis = `const cart = {
  items: ["Mug", "Sticker"],
  logItems: function () {
    this.items.forEach(function (item) {
      // Inside this plain callback, "this" is NOT the cart anymore —
      // it's undefined (in strict mode) or the global object.
      console.log(this.storeName + ": " + item); // TypeError
    });
  },
};`;

const arrowFnThis = `const cart = {
  items: ["Mug", "Sticker"],
  storeName: "Corner Shop",
  logItems: function () {
    this.items.forEach((item) => {
      // An arrow function has no "this" of its own — it uses
      // whatever "this" was in logItems, which is the cart. Works.
      console.log(this.storeName + ": " + item);
    });
  },
};
cart.logItems();
// Corner Shop: Mug
// Corner Shop: Sticker`;

const arrowShapes = `// No arguments
const sayHi = () => console.log("hi");

// One argument — parens are optional
const double = (n) => n * 2;
const double2 = n => n * 2; // same thing

// Multiple arguments — parens required
const add = (a, b) => a + b;

// Implicit return: no { } means "return this expression"
const square = (n) => n * n;

// Block body: use { } and an explicit "return" for multiple statements
const describe = (n) => {
  const parity = n % 2 === 0 ? "even" : "odd";
  return \`\${n} is \${parity}\`;
};`;

const templateBasic = `const product = "Wireless Mouse";
const price = 24.99;

// ES5 — string concatenation
var line1 = "Buy " + product + " for $" + price.toFixed(2);

// Modern — a template literal (backticks, not quotes)
const line2 = \`Buy \${product} for $\${price.toFixed(2)}\`;
// Both produce: "Buy Wireless Mouse for $24.99"`;

const templateMultiline = `// Multi-line strings, no \\n needed
const receipt = \`
  Order #4821
  \${product} x1
  Total: $\${price.toFixed(2)}
\`;
// (any expression goes inside \${ } — not just variables)`;

const arrayDestructure = `const products = ["Mug", "Sticker", "Tote Bag"];

// ES5
var first = products[0];
var second = products[1];

// Modern — array destructuring, by position
const [first2, second2] = products;
console.log(first2, second2); // "Mug" "Sticker"

// Skip an item with a blank slot
const [, , third] = products;
console.log(third); // "Tote Bag"`;

const objectDestructure = `// Data shaped like what a Shopify Admin API response looks like
const product = { id: "gid://1", title: "Mug", price: 12, vendor: "Acme" };

// ES5
var title = product.title;
var price = product.price;

// Modern — object destructuring, by KEY name (order doesn't matter)
const { title: title2, price: price2 } = product;

// Rename while destructuring, and give a default for a field
// that might not exist:
const { vendor: brand, inStock = true } = product;
console.log(brand, inStock); // "Acme" true`;

const defaultParams = `// ES5 — manually filling in a missing argument
function greet(name) {
  name = name || "there";
  return "Hi, " + name;
}

// Modern — a default value right in the parameter list
function greet2(name = "there") {
  return \`Hi, \${name}\`;
}
greet2();        // "Hi, there"
greet2("Sam");   // "Hi, Sam"`;

const spreadArrays = `const base = ["Mug", "Sticker"];

// Copy an array (not a reference to the same array)
const copy = [...base];

// Merge two arrays
const seasonal = ["Snow Globe"];
const allProducts = [...base, ...seasonal];
// ["Mug", "Sticker", "Snow Globe"]

// Add an item WITHOUT mutating the original — the pattern
// you'll use constantly in React state updates
const withNew = [...base, "Tote Bag"];`;

const spreadObjects = `const note = { productId: "123", body: "Restock" };

// Merge/override fields into a NEW object — doesn't touch "note"
const updated = { ...note, body: "Restock — confirmed", priority: "high" };
// { productId: "123", body: "Restock — confirmed", priority: "high" }`;

const restParams = `// Rest — collects "the remaining arguments" into a real array
function total(...amounts) {
  return amounts.reduce((sum, n) => sum + n, 0);
}
total(10, 20, 30); // 60

// Rest in destructuring — "everything else"
const { title, ...otherFields } = product;
// title: "Mug", otherFields: { id, price, vendor }`;

const shallowCopyGotcha = `const original = { customer: { name: "Sam" }, total: 40 };
const copy = { ...original };

copy.total = 50;              // fine — original.total is still 40
copy.customer.name = "Alex";  // ⚠ original.customer.name is ALSO "Alex"

// Spread only copies the top level. Nested objects/arrays are
// still shared references between the original and the copy.`;

const namedExport = `// math.js
export function add(a, b) {
  return a + b;
}
export const PI = 3.14159;

// app.js
import { add, PI } from "./math.js";
add(2, PI);`;

const defaultExport = `// note-card.js
export default function NoteCard({ body }) {
  // ...
}

// app.js — a default export can be imported under any name
import NoteCard from "./note-card.js";
import Card from "./note-card.js"; // also valid, same thing`;

const browserModulesEx = `<!-- index.html -->
<!-- The type="module" attribute is what makes import/export legal here.
     Without it, a plain <script> throws a SyntaxError on "import". -->
<script type="module" src="/app.js"></script>`;

const browserModulesJs = `// app.js
import { add, PI } from "./math.js";

console.log(add(2, PI));
// No build step, no bundler — the browser fetches math.js itself and
// runs this directly. Try it: save two files like this next to each
// other and open the HTML file with a local dev server (opening it as
// a bare file:// URL will hit CORS errors — modules require http(s)).`;

const moduleScopeEx = `<script>
  var x = "classic script";
</script>
<script type="module">
  console.log(window.x); // "classic script" — classic scripts leak to window

  var y = "module script";
  console.log(window.y); // undefined — modules do NOT leak, even with var
  console.log(this);     // undefined — top-level "this" is undefined in a module
                          // (it's "window" in a classic script)
</script>`;

const moduleCachingEx = `// counter.js
console.log("counter.js ran");
export let count = 0;

// a.js
import { count } from "./counter.js"; // logs "counter.js ran"

// b.js — imported on the same page, AFTER a.js
import { count } from "./counter.js"; // logs nothing — already cached.
// Every module runs exactly once per page, no matter how many
// other files import it. Both a.js and b.js share the SAME "count".`;

const fullExampleHtml = `<!-- index.html -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Module demo</title>
</head>
<body>
  <p>Order total: <span id="total">—</span></p>

  <!-- One entry point. Everything it imports loads automatically. -->
  <script type="module" src="/app.js"></script>
</body>
</html>`;

const fullExampleMathJs = `// math.js
export function add(a, b) {
  return a + b;
}

export function applyTax(amount, rate) {
  return amount * (1 + rate);
}`;

const fullExampleFormatJs = `// format.js
// A default export — this file's one main job is formatting currency.
export default function formatCurrency(amount) {
  return \`$\${amount.toFixed(2)}\`;
}`;

const fullExampleAppJs = `// app.js — the entry point referenced by index.html
import { add, applyTax } from "./math.js";
import formatCurrency from "./format.js";

const subtotal = add(19.99, 5.0);
const total = applyTax(subtotal, 0.08);

document.getElementById("total").textContent = formatCurrency(total);
// "$27.01"`;

const importMapEx = `<!-- Without an import map, this fails —
     browsers can only resolve relative (./), absolute (/), or full
     URLs on their own. A bare word like "lodash-es" means nothing
     to a browser by itself: -->
<script type="module">
  import { debounce } from "lodash-es"; // TypeError: Failed to resolve module specifier
</script>

<!-- An import map teaches the browser what bare specifiers mean,
     BEFORE any module script runs: -->
<script type="importmap">
{
  "imports": {
    "lodash-es": "https://cdn.jsdelivr.net/npm/lodash-es@4.17.21/lodash.js",
    "utils/": "/src/utils/"
  }
}
</script>

<script type="module">
  import { debounce } from "lodash-es";          // now resolves ✓
  import { formatDate } from "utils/dates.js";   // "utils/" maps to /src/utils/
</script>`;

const commonjsAside = `// You'll still see this older Node.js style ("CommonJS") here and there:
const fs = require("fs");
module.exports = { readConfig };

// Modern Node and the whole Shopify app template use ESM
// (the import/export syntax above) instead — CommonJS is legacy,
// not something you need to write yourself, just recognize on sight.`;

const callbackHell = `// "Callback hell" — the pre-Promise way of chaining async steps
getProduct(id, function (product) {
  getReviews(product.id, function (reviews) {
    getAuthor(reviews[0].authorId, function (author) {
      console.log(author.name);
      // one more nested step and this becomes unreadable
    });
  });
});`;

const promiseChain = `// A Promise represents "a value that will exist later" —
// it's either pending, fulfilled (.then), or rejected (.catch)
getProduct(id)
  .then((product) => getReviews(product.id))
  .then((reviews) => getAuthor(reviews[0].authorId))
  .then((author) => console.log(author.name))
  .catch((err) => console.error("Something failed:", err));`;

const asyncAwait = `// async/await — Promises, written to read like ordinary
// step-by-step code (this is what you'll actually write day to day)
async function logFirstReviewAuthor(id) {
  try {
    const product = await getProduct(id);
    const reviews = await getReviews(product.id);
    const author = await getAuthor(reviews[0].authorId);
    console.log(author.name);
  } catch (err) {
    console.error("Something failed:", err);
  }
}`;

const realLoaderAsync = `// This is the exact shape you'll write constantly in a Shopify app —
// a route loader that awaits the Admin API before the page can render
export async function loader({ request }) {
  const { admin } = await authenticate.admin(request);
  const response = await admin.graphql(\`{ products(first: 5) { edges { node { id title } } } }\`);
  const { data } = await response.json();
  return { products: data.products.edges.map((e) => e.node) };
}`;

const promiseAllExample = `// Awaiting one at a time when the calls don't depend on each other
// wastes time — they run one after another instead of together:
const products = await getProducts();   // waits
const settings = await getSettings();   // THEN waits again

// Promise.all runs independent promises concurrently:
const [products2, settings2] = await Promise.all([
  getProducts(),
  getSettings(),
]);`;

const classExample = `class Cart {
  constructor(shop) {
    this.shop = shop;
    this.items = [];
  }

  add(item) {
    this.items.push(item);
  }

  get total() {
    return this.items.reduce((sum, i) => sum + i.price, 0);
  }
}

const cart = new Cart("corner-shop.myshopify.com");
cart.add({ name: "Mug", price: 12 });
console.log(cart.total); // 12`;

const classExtends = `class DiscountCart extends Cart {
  constructor(shop, discountPercent) {
    super(shop); // must call super() before using "this"
    this.discountPercent = discountPercent;
  }

  get total() {
    const fullTotal = super.total; // reuse the parent's calculation
    return fullTotal * (1 - this.discountPercent / 100);
  }
}`;

const optionalChaining = `const order = { customer: { name: "Sam" } };

// ES5-era — you had to guard every step by hand
var city = order.customer && order.customer.address && order.customer.address.city;

// Modern — optional chaining short-circuits to undefined
// the instant something along the chain is null/undefined
const city2 = order.customer?.address?.city; // undefined, no crash

// Works on function calls too — only calls if the function exists
order.onSave?.();`;

const nullishCoalescing = `const settings = { retries: 0, timeout: null };

// ||  treats EVERY falsy value (0, "", false, null, undefined) as "missing"
const retries1 = settings.retries || 3; // 3 — wrong! 0 is a valid setting.

// ??  only falls back on null or undefined specifically
const retries2 = settings.retries ?? 3; // 0 — correct.
const timeout2 = settings.timeout ?? 5000; // 5000 — timeout really is null`;

// ---- Chapter 10: array & object utilities ----

const includesEx = `const tags = ["sale", "new", "limited"];

// Old way
if (tags.indexOf("sale") !== -1) { /* ... */ }

// Modern — reads as what it means
if (tags.includes("sale")) { /* ... */ }`;

const flatMapEx = `const orders = [["Mug"], ["Sticker", "Tote Bag"], []];

orders.flat();
// ["Mug", "Sticker", "Tote Bag"] — flattens one level deep

const prices = [10, 20, 30];
prices.flatMap((p) => [p, p * 1.1]);
// [10, 11, 20, 22, 30, 33] — map, then flatten the results`;

const entriesValuesEx = `const stock = { mugs: 12, stickers: 40, totes: 3 };

Object.keys(stock);   // ["mugs", "stickers", "totes"]
Object.values(stock); // [12, 40, 3]
Object.entries(stock);
// [["mugs", 12], ["stickers", 40], ["totes", 3]] — perfect for looping:

for (const [name, count] of Object.entries(stock)) {
  console.log(\`\${name}: \${count}\`);
}`;

const fromEntriesEx = `const pairs = [["mugs", 12], ["stickers", 40]];

Object.fromEntries(pairs);
// { mugs: 12, stickers: 40 } — the reverse of Object.entries()
// handy after filtering/mapping an object's entries as an array`;

const atMethodEx = `const items = ["Mug", "Sticker", "Tote Bag"];

// Old way to get the last item
items[items.length - 1]; // "Tote Bag"

// Modern — negative indices count from the end
items.at(-1); // "Tote Bag"
items.at(-2); // "Sticker"`;

const findLastEx = `const events = [
  { type: "created", at: 1 },
  { type: "updated", at: 2 },
  { type: "updated", at: 3 },
];

events.find((e) => e.type === "updated");     // the FIRST match (at: 2)
events.findLast((e) => e.type === "updated"); // the LAST match (at: 3)`;

const hasOwnEx = `const note = { body: "Restock" };

// Old way — works, but reads awkwardly and can misbehave on
// objects with an overridden hasOwnProperty
Object.prototype.hasOwnProperty.call(note, "body");

// Modern — a plain, safe static method
Object.hasOwn(note, "body");   // true
Object.hasOwn(note, "author"); // false`;

// ---- Chapter 11: string & number niceties ----

const padEx = `const orderIds = [4, 82, 156];

orderIds.map((id) => String(id).padStart(5, "0"));
// ["00004", "00082", "00156"] — handy for order numbers, invoice IDs

"Sam".padEnd(10, ".");
// "Sam......."`;

const trimEx = `const input = "   sam@example.com  ";

input.trim();       // "sam@example.com" (both sides — you likely knew this one)
input.trimStart();  // "sam@example.com  " (left only)
input.trimEnd();    // "   sam@example.com" (right only)`;

const replaceAllEx = `const sku = "MUG-RED-SMALL";

// Old way — replace() only replaces the FIRST match unless you
// pass a global regex, which trips people up constantly
sku.replace(/-/g, "_");

// Modern — does what it says, no regex needed for a plain string
sku.replaceAll("-", "_");
// "MUG_RED_SMALL"`;

const matchAllEx = `const text = "Order #4821, Order #5190, Order #6003";

// Old way — only gets the first match with a plain regex
text.match(/Order #(\\d+)/);

// Modern — an iterator over EVERY match, each with its capture groups
for (const match of text.matchAll(/Order #(\\d+)/g)) {
  console.log(match[1]); // "4821", then "5190", then "6003"
}`;

const numericSeparatorEx = `// Old way — hard to tell how many zeros at a glance
const inCents1 = 1000000;

// Modern — underscores as a purely visual separator (ignored by JS)
const inCents2 = 1_000_000;
console.log(inCents1 === inCents2); // true`;

const bigIntEx = `// Regular numbers lose precision above 2^53
9007199254740993 === 9007199254740992; // true — wrong! precision lost.

// BigInt — a second numeric type for integers of any size,
// written with an "n" suffix. Rare in everyday app code (Shopify's
// GraphQL API returns normal numbers/strings), but good to recognize.
const big = 9007199254740993n;
typeof big; // "bigint"`;

// ---- Chapter 12: more Promise tools ----

const promiseFinallyEx = `showSpinner();

fetchOrder(id)
  .then((order) => render(order))
  .catch((err) => showError(err))
  .finally(() => hideSpinner());
  // .finally runs whether it succeeded or failed — perfect for
  // "stop the loading spinner" cleanup you'd otherwise have to
  // duplicate in both .then and .catch`;

const allSettledEx = `// Promise.all rejects ENTIRELY if even one promise rejects —
// you lose the results of everything that succeeded.
// Promise.allSettled always waits for all of them and reports each outcome:
const results = await Promise.allSettled([
  fetchProduct(1),
  fetchProduct(2), // suppose this one fails
  fetchProduct(3),
]);
// [
//   { status: "fulfilled", value: {...} },
//   { status: "rejected", reason: Error(...) },
//   { status: "fulfilled", value: {...} },
// ]`;

const promiseAnyEx = `// Promise.any resolves as soon as ANY promise succeeds,
// and only rejects if ALL of them fail. Useful for "try several
// sources, take whichever answers first":
const fastest = await Promise.any([
  fetchFromMirror1(),
  fetchFromMirror2(),
  fetchFromMirror3(),
]);`;

const topLevelAwaitEx = `// Inside a module (not inside a function), you can now
// "await" directly at the top level — no wrapping async function needed:
const config = await loadConfig();
console.log(config.apiUrl);
// Only works in ESM modules (Chapter 07) — not in CommonJS files or
// in a script tag without type="module".`;

const forAwaitEx = `// Looping over a sequence of promises/async values one at a time
async function logAll(urls) {
  for await (const response of urls.map(fetch)) {
    console.log(response.status);
  }
}
// Niche — you'll meet it if you work with streaming APIs or
// async generators, rarely needed in a typical Shopify app route.`;

// ---- Chapter 13: small syntax sugar ----

const logicalAssignEx = `let config = { retries: 0, timeout: null, cache: undefined };

// Old way
config.timeout = config.timeout || 5000;

// Modern — combines the operator with assignment, and only
// assigns when the check on the left calls for it
config.timeout ??= 5000;   // assign only if null/undefined
config.cache ||= {};       // assign only if falsy
config.retries &&= 10;     // reassign only if currently truthy`;

const globalThisEx = `// Old way — which global object you're on depends on the
// environment (window in a browser, global in Node, self in a worker)
// so cross-environment code needed awkward feature-detection.

// Modern — one name that always works, everywhere JS runs
globalThis.fetch;
globalThis.setTimeout;`;

const dynamicImportEx = `// Static imports (Chapter 07) all load up front. A dynamic import()
// loads a module on demand — as a Promise — which is how code-splitting
// (loading a big chart library only when the user opens the chart page,
// for instance) works under the hood in Vite/React Router.
button.addEventListener("click", async () => {
  const { renderChart } = await import("./chart.js");
  renderChart(data);
});`;

const privateFieldsEx = `class Cart {
  #items = []; // "#" makes this field private — inaccessible outside the class

  add(item) {
    this.#items.push(item);
  }

  get count() {
    return this.#items.length;
  }
}

const cart = new Cart();
cart.add({ name: "Mug" });
cart.count;     // 1
cart.#items;    // SyntaxError — not accessible from outside the class`;

const errorCauseEx = `try {
  await syncInventory();
} catch (err) {
  // "cause" lets you wrap a lower-level error without losing it,
  // instead of just re-throwing a new, less specific one
  throw new Error("Inventory sync failed", { cause: err });
}`;

// ---- Chapter 14: brand-new, check compatibility first ----

const immutableArrayMethodsEx = `const prices = [30, 10, 20];

// .sort() mutates the ORIGINAL array — a classic source of bugs
prices.sort(); // prices is now [10, 20, 30], permanently

// toSorted() / toReversed() / toSpliced() / with() return a
// NEW array instead, leaving the original untouched
const original = [30, 10, 20];
const sorted = original.toSorted();
console.log(original); // still [30, 10, 20]
console.log(sorted);   // [10, 20, 30]`;

const groupByEx = `const products = [
  { name: "Mug", category: "Kitchen" },
  { name: "Sticker", category: "Stationery" },
  { name: "Mug Warmer", category: "Kitchen" },
];

Object.groupBy(products, (p) => p.category);
// {
//   Kitchen: [{ name: "Mug", ... }, { name: "Mug Warmer", ... }],
//   Stationery: [{ name: "Sticker", ... }],
// }
// Before this existed, grouping meant hand-rolling a reduce().`;

const setMethodsEx = `const inStock = new Set(["Mug", "Sticker", "Tote Bag"]);
const onSale = new Set(["Sticker", "Snow Globe"]);

inStock.intersection(onSale); // Set {"Sticker"} — in both
inStock.difference(onSale);   // Set {"Mug", "Tote Bag"} — in stock, not on sale
inStock.union(onSale);        // Set {"Mug", "Sticker", "Tote Bag", "Snow Globe"}`;

const structuredCloneEx = `const original = { customer: { name: "Sam" }, items: ["Mug"] };

// Unlike spread (Chapter 06), this is a REAL deep copy —
// nested objects/arrays are fully independent afterward
const copy = structuredClone(original);
copy.customer.name = "Alex";
console.log(original.customer.name); // still "Sam"`;

const promiseWithResolversEx = `// Old way to get a promise's resolve/reject functions OUT of its executor
function oldWay() {
  let resolve, reject;
  const promise = new Promise((res, rej) => { resolve = res; reject = rej; });
  return { promise, resolve, reject };
}

// Modern — the same thing, built in
const { promise, resolve, reject } = Promise.withResolvers();`;
---
