---
import BaseLayout from '../../layouts/BaseLayout.astro';

const platformBooks = [
  {
    order: 1,
    title: 'How Shopify Apps Work',
    href: '/crash-courses/how-shopify-apps-work',
    chapters: 9,
    time: '45–55 min',
    desc: 'No code — just the platform. What an app actually is, what happens when a merchant clicks Install, and how apps are allowed to touch a store. Start here.',
  },
];

const toolkitBooks = [
  {
    order: 2,
    title: 'Modern JavaScript (ES6+)',
    href: '/crash-courses/modern-javascript',
    chapters: 14,
    time: '80–95 min',
    desc: "ES6 through today (ES2024+), for readers whose JavaScript stopped at ES5 — with a support tag on every feature so you know what's safe to use where.",
  },
  {
    order: 3,
    title: 'TypeScript',
    href: '/crash-courses/typescript',
    chapters: 8,
    time: '45–55 min',
    desc: 'JavaScript with a spell-checker for your data. Every other toolkit course assumes you can read a type.',
  },
  {
    order: 4,
    title: 'React',
    href: '/crash-courses/react',
    chapters: 8,
    time: '55–65 min',
    desc: 'Stop hand-editing the DOM. Build UI by describing what it should look like, and let React handle the rest.',
  },
  {
    order: 5,
    title: 'React Router 7',
    href: '/crash-courses/react-router-7',
    chapters: 6,
    time: '40–50 min',
    desc: 'The framework the Shopify app template runs on: file routes, loaders, and actions — how a page gets its data.',
  },
  {
    order: 6,
    title: 'Node.js',
    href: '/crash-courses/node',
    chapters: 7,
    time: '40–50 min',
    desc: 'JavaScript running on a server instead of a browser. Modules, npm, async/await, and how a request gets a response.',
  },
  {
    order: 7,
    title: 'GraphQL',
    href: '/crash-courses/graphql',
    chapters: 6,
    time: '35–45 min',
    desc: "The language you'll use to ask Shopify's Admin API for exactly the data you want — no more, no less.",
  },
  {
    order: 8,
    title: 'Databases (SQL Fundamentals)',
    href: '/crash-courses/databases',
    chapters: 9,
    time: '55–70 min',
    desc: 'Tables, primary keys, JOINs, and core SQL — what Prisma is generating for you underneath, and why it matters when a query is slow.',
  },
  {
    order: 9,
    title: 'Prisma',
    href: '/crash-courses/prisma',
    chapters: 6,
    time: '35–45 min',
    desc: 'Talk to a real database using JavaScript objects instead of hand-written SQL, with a safety net built in.',
  },
];

const references = [
  { group: 'Languages & Frameworks', items: [
    { title: 'JSX', href: '/crash-courses/jsx', chapters: 4, time: '15–20 min', desc: 'The markup-in-JS syntax React is built on — and the specific gotchas that trip up HTML habits.' },
    { title: 'Preact', href: '/crash-courses/preact', chapters: 4, time: '12–18 min', desc: 'A ~4KB React alternative that copies its API on purpose — where it fits, and where it doesn’t.' },
    { title: 'Remix → React Router', href: '/crash-courses/remix-to-react-router', chapters: 3, time: '8–12 min', desc: 'What happened to Remix — a naming history, not a new framework to learn.' },
    { title: 'Web Components', href: '/crash-courses/web-components', chapters: 4, time: '15–20 min', desc: 'The browser-native standard behind Shopify’s Polaris Web Components, used in Admin and Checkout extensions.' },
  ]},
  { group: 'Tooling & Config', items: [
    { title: 'npm scripts', href: '/crash-courses/npm-scripts', chapters: 4, time: '15–20 min', desc: 'What "npm run dev" actually does under the hood, and why bare command names work inside one.' },
    { title: 'npx', href: '/crash-courses/npx', chapters: 4, time: '12–18 min', desc: 'Running a package’s command-line tool without a permanent install.' },
    { title: 'ESLint', href: '/crash-courses/eslint', chapters: 4, time: '15–20 min', desc: 'Catching likely bugs and style issues before you ever run the code.' },
    { title: 'TOML', href: '/crash-courses/toml', chapters: 4, time: '12–18 min', desc: 'The config format behind shopify.app.toml, read line by line.' },
  ]},
];
---
<BaseLayout
  title="Crash Courses — Shopify App Handbook"
  description="Beginner-first, book-style crash courses on the individual pieces the Roadmap and Getting Started pages assume you know."
  accent="violet"
  footerNote={`Have a topic you want prioritized? Just ask — this list grows on request. Deeper coverage of every topic here also lives in the full <a href="/roadmap">Roadmap</a>.`}
>
  <div class="hero">
    <p class="eyebrow">Fill in the toolkit</p>
    <h1 class="page-title">Crash Courses</h1>
    <p class="lede">Nine short books, each written for one reader: someone who knows HTML, CSS, and plain (pre-2015) JavaScript, and nothing else on this list — not even modern JavaScript syntax. No prior Shopify, React, TypeScript, or backend experience assumed anywhere.</p>
    <div class="meta-row">
      <span class="meta-chip">9 courses</span>
      <span class="meta-chip">8 quick references</span>
      <span class="meta-chip">$0 required</span>
    </div>
  </div>

  <div class="howread">
    <div class="howread-label">How these are built</div>
    <p>Every course opens with a sidebar table of contents on the left — click any chapter to jump straight to it, and it tracks where you are as you scroll. Chapters build on each other in order, so the first read-through goes top to bottom. Come back later and use the sidebar to jump to just the part you forgot.</p>
  </div>

  <div class="path-label">01 &middot; Understand the platform</div>
  <ol class="booklist">
    {platformBooks.map((b) => (
      <li>
        <a class="book" href={b.href}>
          <div class="book-num">{String(b.order).padStart(2, '0')}</div>
          <div class="book-body">
            <h2>{b.title}</h2>
            <p>{b.desc}</p>
            <div class="book-meta">
              <span>{b.chapters} chapters</span>
              <span class="dot">&middot;</span>
              <span>{b.time}</span>
            </div>
          </div>
          <div class="book-go">Read &rarr;</div>
        </a>
      </li>
    ))}
  </ol>

  <div class="path-label">02–09 &middot; Learn the toolkit</div>
  <ol class="booklist">
    {toolkitBooks.map((b) => (
      <li>
        <a class="book" href={b.href}>
          <div class="book-num">{String(b.order).padStart(2, '0')}</div>
          <div class="book-body">
            <h2>{b.title}</h2>
            <p>{b.desc}</p>
            <div class="book-meta">
              <span>{b.chapters} chapters</span>
              <span class="dot">&middot;</span>
              <span>{b.time}</span>
            </div>
          </div>
          <div class="book-go">Read &rarr;</div>
        </a>
      </li>
    ))}
  </ol>

  <div class="soon-head">
    <h2>Quick References</h2>
    <p>Shorter than a full course — one sitting, no chapter-to-chapter build-up required. Each still follows the same zero-assumed-knowledge rule and links to real docs to go deeper.</p>
  </div>

  {references.map((group) => (
    <div class="catgroup">
      <h2>{group.group}</h2>
      <div class="topicgrid">
        {group.items.map((item) => (
          <a class="topiccard" href={item.href}>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
            <div class="topiccard-meta">
              <span>{item.chapters} chapters</span>
              <span class="dot">&middot;</span>
              <span>{item.time}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  ))}

</BaseLayout>

<style>
  .hero { margin-bottom: 36px; }

  .howread {
    background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--accent);
    border-radius: 10px; padding: 20px 24px; margin-bottom: 48px; box-shadow: var(--shadow);
  }
  .howread-label {
    font-family: 'IBM Plex Mono', monospace; font-size: 0.76rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent); margin-bottom: 8px;
  }
  .howread p { margin: 0; font-size: var(--fs-small); color: var(--text-dim); line-height: 1.65; }

  .path-label {
    font-family: 'IBM Plex Mono', monospace; font-weight: 700; font-size: 0.86rem; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--text-dim); border-bottom: 1px solid var(--line);
    padding-bottom: 14px; margin: 0 0 20px;
  }

  .booklist { list-style: none; margin: 0 0 56px; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .book {
    display: flex; align-items: center; gap: 22px; text-decoration: none;
    background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
    padding: 24px 26px; box-shadow: var(--shadow); transition: border-color .15s ease, transform .15s ease;
  }
  .book:hover { border-color: var(--accent); transform: translateY(-2px); }
  .book-num {
    font-family: 'IBM Plex Mono', monospace; font-weight: 700; font-size: 1.6rem;
    color: var(--accent); opacity: 0.55; flex-shrink: 0; width: 44px;
  }
  .book-body { flex: 1; min-width: 0; }
  .book-body h2 { font-family: 'IBM Plex Mono', monospace; font-weight: 700; font-size: 1.3rem; margin: 0 0 8px; color: var(--text); }
  .book-body p { font-size: var(--fs-small); color: var(--text-dim); margin: 0 0 10px; line-height: 1.6; }
  .book-meta { font-family: 'IBM Plex Mono', monospace; font-size: 0.8rem; color: var(--text-dim); }
  .book-meta .dot { margin: 0 8px; opacity: 0.6; }
  .book-go {
    font-family: 'IBM Plex Mono', monospace; font-size: 0.9rem; font-weight: 600; color: var(--accent);
    flex-shrink: 0; white-space: nowrap;
  }

  .soon-head { margin-bottom: 24px; }
  .soon-head h2 {
    font-family: 'IBM Plex Mono', monospace; font-weight: 700; font-size: 1.1rem; margin: 0 0 8px; color: var(--text);
  }
  .soon-head p { font-size: var(--fs-small); color: var(--text-dim); margin: 0; }

  .topiccard-meta {
    font-family: 'IBM Plex Mono', monospace; font-size: 0.76rem; color: var(--text-dim); margin-top: 12px;
  }
  .topiccard-meta .dot { margin: 0 7px; opacity: 0.6; }

  @media (max-width: 620px) {
    .book { flex-wrap: wrap; }
    .book-go { width: 100%; }
  }
</style>
