---
import CourseLayout from '../../layouts/CourseLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { withBase } from '../../lib/url';

const chapters = [
  { id: 'why-react', title: 'The problem React solves' },
  { id: 'jsx', title: 'JSX: HTML-shaped JavaScript' },
  { id: 'components-props', title: 'Components & props' },
  { id: 'state', title: 'State: giving a component memory' },
  { id: 'lists-keys', title: 'Rendering lists & the key prop' },
  { id: 'events-forms', title: 'Events & forms' },
  { id: 'effects', title: 'Effects: reaching outside React' },
  { id: 'putting-together', title: 'Putting it together' },
];

const manualDomCode = `<button id="counter">Clicked 0 times</button>

<script>
  let count = 0;
  const btn = document.getElementById("counter");
  btn.addEventListener("click", () => {
    count = count + 1;
    btn.textContent = "Clicked " + count + " times";
    // Every single thing that can change has to be found and
    // updated by hand, every time. Multiply this by 40 buttons,
    // toggles, and lists, and it stops being manageable.
  });
</script>`;

const declarativeIdeaCode = `// Instead of "find the button, then change its text",
// React wants you to answer one question, over and over:
//
//   Given the current data, what should the screen look like?
//
// You describe THAT, and React figures out what actually needs
// to change in the real DOM. You never call .textContent again.`;

const jsxBasicCode = `function Greeting() {
  return <h1>Welcome to the store</h1>;
}

// This isn't a string, and it isn't HTML — it's JSX, and it
// compiles down to plain JavaScript function calls. You never
// call those functions yourself; the JSX syntax is the friendly
// way to write them.`;

const jsxExpressionCode = `function Greeting() {
  const shopName = "Loom & Wick";
  const itemCount = 3;

  return (
    <div>
      <h1>Welcome to {shopName}</h1>
      <p>You have {itemCount} item{itemCount === 1 ? "" : "s"} in your cart.</p>
    </div>
  );
}
// Anything inside curly braces { } is plain JavaScript, evaluated
// and dropped into the markup. Everything outside them is JSX.`;

const jsxRulesCode = `// A few JSX rules that trip up everyone once:

// 1. One root element per return — wrap siblings in a fragment:
return (
  <>
    <h1>Title</h1>
    <p>Body</p>
  </>
);

// 2. "class" is "className" (class is a reserved word in JS):
<div className="card">...</div>

// 3. Every tag must close — <img /> and <br />, not <img> and <br>.`;

const propsCode = `interface ProductCardProps {
  name: string;
  price: number;
}

function ProductCard({ name, price }: ProductCardProps) {
  return (
    <div className="card">
      <h3>{name}</h3>
      <p>\${price.toFixed(2)}</p>
    </div>
  );
}

// Used like a custom HTML tag, with attributes as props:
<ProductCard name="Wireless Mouse" price={24.99} />
<ProductCard name="Desk Lamp" price={39.5} />`;

const propsFlowCode = `// Props flow one way: parent to child. A component never
// reaches "up" to change its parent — it can only display
// whatever it was handed, the same way a function only sees
// the arguments it was called with.

function ProductList() {
  return (
    <div>
      <ProductCard name="Wireless Mouse" price={24.99} />
      <ProductCard name="Desk Lamp" price={39.5} />
    </div>
  );
}
// ProductList owns the data. ProductCard just renders it.`;

const stateProblemCode = `function LikeButton() {
  let liked = false; // this will NOT work as you'd expect

  return (
    <button onClick={() => { liked = !liked; }}>
      {liked ? "Liked" : "Like"}
    </button>
  );
}
// Clicking this button changes the "liked" variable, but React
// has no idea the variable changed — so it never re-renders,
// and the button's label never updates on screen.`;

const useStateCode = `import { useState } from "react";

function LikeButton() {
  const [liked, setLiked] = useState(false);

  return (
    <button onClick={() => setLiked(!liked)}>
      {liked ? "Liked" : "Like"}
    </button>
  );
}
// useState(false) returns a pair: the current value ("liked"),
// and a function to change it ("setLiked"). Calling setLiked is
// how you tell React "the data changed, please re-render."`;

const stateArrayCode = `const [items, setItems] = useState<string[]>([]);

function addItem(name: string) {
  // Never mutate state directly — .push() won't trigger a re-render.
  // Always create a new array (or object) and pass that to the setter:
  setItems([...items, name]);
}`;

const listCode = `interface Note {
  id: string;
  body: string;
}

function NoteList({ notes }: { notes: Note[] }) {
  return (
    <ul>
      {notes.map((note) => (
        <li key={note.id}>{note.body}</li>
      ))}
    </ul>
  );
}`;

const keyWhyCode = `// Without a stable "key", React can't tell which item is which
// between renders — it falls back to guessing by position, which
// causes subtle bugs: form inputs keeping the wrong value after
// a reorder, animations firing on the wrong item, and so on.

// key must be:
//  - unique among siblings
//  - stable across re-renders (a database id — never the array index
//    if the list can reorder, get filtered, or have items removed)

{notes.map((note) => <li key={note.id}>{note.body}</li>)}   // good
{notes.map((note, i) => <li key={i}>{note.body}</li>)}      // risky`;

const formCode = `function NoteForm({ onAdd }: { onAdd: (body: string) => void }) {
  const [draft, setDraft] = useState("");

  function handleSubmit(e: React.FormEvent) {
    e.preventDefault(); // stop the browser's default full-page reload
    if (draft.trim() === "") return;
    onAdd(draft);
    setDraft(""); // clear the input after submitting
  }

  return (
    <form onSubmit={handleSubmit}>
      <input
        value={draft}
        onChange={(e) => setDraft(e.target.value)}
        placeholder="Write a note..."
      />
      <button type="submit">Add</button>
    </form>
  );
}`;

const controlledExplainCode = `// This input is "controlled": its value comes FROM state
// (value={draft}), and every keystroke pushes the new value
// BACK into state (onChange). React state is the single
// source of truth — the DOM input never holds its own answer.
//
//   type a key -> onChange fires -> setDraft runs -> component
//   re-renders -> input's value prop reflects the new state`;

const effectBasicCode = `import { useEffect, useState } from "react";

function ShopStatus() {
  const [status, setStatus] = useState("checking...");

  useEffect(() => {
    fetch("/api/status")
      .then((res) => res.json())
      .then((data) => setStatus(data.status));
  }, []); // empty array = run once, right after the first render

  return <p>Status: {status}</p>;
}`;

const effectDepsCode = `function ProductDetails({ productId }: { productId: string }) {
  const [product, setProduct] = useState(null);

  useEffect(() => {
    fetch(\`/api/products/\${productId}\`)
      .then((res) => res.json())
      .then((data) => setProduct(data));
  }, [productId]);
  // The dependency array says "re-run this effect whenever
  // productId changes." Leave it out entirely, and the effect
  // re-runs after every single render — almost never what you want.

  if (!product) return <p>Loading...</p>;
  return <h2>{product.name}</h2>;
}`;

const fullFeatureCode = `import { useState } from "react";

interface Note {
  id: string;
  body: string;
}

export default function NotesWidget() {
  const [notes, setNotes] = useState<Note[]>([]);
  const [draft, setDraft] = useState("");

  function addNote(e: React.FormEvent) {
    e.preventDefault();
    if (!draft.trim()) return;
    setNotes([...notes, { id: crypto.randomUUID(), body: draft }]);
    setDraft("");
  }

  function removeNote(id: string) {
    setNotes(notes.filter((n) => n.id !== id));
  }

  return (
    <div>
      <form onSubmit={addNote}>
        <input
          value={draft}
          onChange={(e) => setDraft(e.target.value)}
          placeholder="Write a note..."
        />
        <button type="submit">Add</button>
      </form>

      <ul>
        {notes.map((note) => (
          <li key={note.id}>
            {note.body}
            <button onClick={() => removeNote(note.id)}>Remove</button>
          </li>
        ))}
      </ul>
    </div>
  );
}
// Every idea from this course, in one 30-line component:
// state (notes, draft), a controlled form, a list with keys,
// and two event handlers that call setters instead of
// touching the DOM directly.`;
---
<CourseLayout
  title="React Crash Course — Shopify App Handbook"
  description="React from first principles for readers who know HTML, CSS, and JavaScript but have never touched a frontend framework. Components, props, state, and effects."
  accent="blue"
  courseTitle="React"
  courseTagline="A JavaScript library for building UI by describing what it should look like, not by writing step-by-step instructions to change it. This is the UI layer under every screen in a Shopify app."
  readTime="55–65 min"
  chapters={chapters}
  prev={{ href: '/crash-courses/typescript', title: 'TypeScript' }}
  next={{ href: '/crash-courses/react-router-7', title: 'React Router 7' }}
>
  <section class="chapter" id="why-react">
    <div class="chapter-num">Chapter 01</div>
    <h2>The problem React solves</h2>
    <p>With plain JavaScript, building an interactive page means writing exact, step-by-step instructions for every possible change: find this element, read its current text, compute the new text, write it back. It works, but every new feature multiplies the amount of manual bookkeeping:</p>
    <CodeBlock code={manualDomCode} lang="html" title="plain HTML + JS" />
    <p>This is called an <strong>imperative</strong> style — you're describing the exact steps to mutate the page, one instruction at a time. It's manageable for one button. It gets unmanageable fast once a page has dozens of things that can change, especially when several of them depend on each other.</p>

    <div class="plain">
      <div class="plain-label">In plain English</div>
      <p>React flips the question. Instead of "how do I change the button's text," you ask "given the current data, what should this button say?" — and write that as a plain description. React re-runs that description whenever the data changes and updates only the parts of the real page that actually need it.</p>
    </div>
    <CodeBlock code={declarativeIdeaCode} lang="js" />
    <p>This is called a <strong>declarative</strong> style, and it's the single idea everything else in React builds on. Every concept in this course — components, state, effects — exists to support that one question: given the data right now, what should the screen show?</p>

    <div class="recap">
      <div class="recap-label">Recap</div>
      <ul>
        <li>Plain JS UI code is imperative: you write the exact steps to mutate the page.</li>
        <li>React is declarative: you describe the desired result for the current data, and React updates the page to match.</li>
      </ul>
    </div>

    <div class="further">
      <div class="further-label">Go deeper</div>
      <ul>
        <li><a href="https://react.dev/learn" target="_blank" rel="noopener">React docs: Quick Start</a> — the official walkthrough this course is based on</li>
        <li><a href="https://react.dev/learn/thinking-in-react" target="_blank" rel="noopener">Thinking in React</a> — the declarative mindset applied step by step to a real UI</li>
      </ul>
    </div>
  </section>

  <section class="chapter" id="jsx">
    <div class="chapter-num">Chapter 02</div>
    <h2>JSX: HTML-shaped JavaScript</h2>
    <p>React components describe UI using <strong>JSX</strong> — markup that looks like HTML, written directly inside JavaScript:</p>
    <CodeBlock code={jsxBasicCode} lang="jsx" />
    <p>That <code>&lt;h1&gt;</code> isn't a string and isn't real HTML — it's syntax that a build tool (already set up for you in the Shopify app template) converts into plain JavaScript before it ever reaches the browser. You write the HTML-shaped version; you never write or think about the converted form.</p>

    <h3>Dropping JavaScript into markup</h3>
    <p>Anything inside curly braces <code>{'{ }'}</code> is evaluated as regular JavaScript, and the result gets inserted into the page:</p>
    <CodeBlock code={jsxExpressionCode} lang="jsx" />

    <div class="plain">
      <div class="plain-label">In plain English</div>
      <p>Read a JSX file the same way you'd read a template: the angle-bracket tags are the shape of the page, and every <code>{'{...}'}</code> is a little window back into real JavaScript — a variable, a calculation, a ternary, a function call.</p>
    </div>

    <h3>A few rules that aren't optional</h3>
    <p>JSX looks like HTML but compiles to JavaScript, so it inherits a few JavaScript constraints HTML doesn't have:</p>
    <CodeBlock code={jsxRulesCode} lang="jsx" />

    <div class="mistakes">
      <div class="mistakes-label">Common mistake</div>
      <ul>
        <li><b>"Adjacent JSX elements must be wrapped in an enclosing tag."</b> This means you returned two sibling elements with nothing wrapping them. Wrap them in a fragment (<code>&lt;&gt;...&lt;/&gt;</code>) or a <code>&lt;div&gt;</code>.</li>
      </ul>
    </div>

    <div class="further">
      <div class="further-label">Go deeper</div>
      <ul>
        <li><a href={withBase("/crash-courses/jsx")}>This site's JSX quick reference</a> — more on lists/keys, fragments, and the specific gotchas (className, self-closing tags) coming from plain HTML</li>
      </ul>
    </div>
  </section>

  <section class="chapter" id="components-props">
    <div class="chapter-num">Chapter 03</div>
    <h2>Components &amp; props</h2>
    <p>A <strong>component</strong> is just a JavaScript function that returns JSX. That's the entire definition — React apps are built by writing many small components and combining them, the same way you'd break a long function into smaller helper functions.</p>

    <p><strong>Props</strong> ("properties") are how a component receives input — they're identical in spirit to function parameters, just written like HTML attributes at the call site:</p>
    <CodeBlock code={propsCode} lang="tsx" />

    <p>The <code>ProductCardProps</code> interface should look familiar from the <a href={withBase("/crash-courses/typescript")}>TypeScript course</a> — this is the exact same "describe the shape, then use it" pattern, applied to a component's inputs.</p>

    <h3>Props only flow downward</h3>
    <CodeBlock code={propsFlowCode} lang="tsx" />
    <p>This one-directional flow is intentional, not a limitation. It means you can look at any component and know exactly where its data came from: its props, passed down from whoever rendered it. There's no hidden path for data to sneak in sideways.</p>

    <div class="tryit">
      <div class="tryit-label">✳ Try it yourself</div>
      <p>Sketch a <code>UserBadge</code> component that takes a <code>name</code> and an <code>avatarUrl</code> prop and renders an image next to the name. Then render three of them with different props, side by side, inside a parent component.</p>
    </div>

    <div class="recap">
      <div class="recap-label">Recap</div>
      <ul>
        <li>A component is a function that returns JSX.</li>
        <li>Props are a component's inputs, passed like HTML attributes.</li>
        <li>Data only flows one way: parent to child, never back up automatically.</li>
      </ul>
    </div>

    <div class="further">
      <div class="further-label">Go deeper</div>
      <ul>
        <li><a href="https://react.dev/learn/your-first-component" target="_blank" rel="noopener">React docs: Your First Component</a></li>
        <li><a href="https://react.dev/learn/passing-props-to-a-component" target="_blank" rel="noopener">React docs: Passing Props to a Component</a></li>
      </ul>
    </div>
  </section>

  <section class="chapter" id="state">
    <div class="chapter-num">Chapter 04</div>
    <h2>State: giving a component memory</h2>
    <p>Props cover data handed to a component from outside. But components also need to track things that change over time from <em>inside</em> — a checkbox being ticked, text being typed, a counter going up. A plain variable seems like the obvious tool, but it doesn't work:</p>
    <CodeBlock code={stateProblemCode} lang="tsx" />

    <div class="plain">
      <div class="plain-label">In plain English</div>
      <p>React only re-runs a component's function (and updates the screen) when it's explicitly told the data changed. Reassigning a normal variable is invisible to React — nothing tells it to look again.</p>
    </div>

    <p>The <code>useState</code> <strong>hook</strong> fixes this — it gives React visibility into the change. A hook is just a special function, always starting with <code>use</code>, that lets a component tap into React features like state; you call it directly inside a component, never inside a condition or a loop:</p>
    <CodeBlock code={useStateCode} lang="tsx" />
    <p>Calling <code>setLiked(...)</code> does two things: it updates the stored value, <em>and</em> it tells React "re-run this component, something changed." That second part is the whole reason <code>useState</code> exists instead of a plain variable.</p>

    <h3>Updating arrays and objects</h3>
    <p>The same rule extends to arrays and objects — React can only see a change if you give it a brand-new value, so mutating methods like <code>.push()</code> won't trigger a re-render:</p>
    <CodeBlock code={stateArrayCode} lang="tsx" />

    <div class="mistakes">
      <div class="mistakes-label">Common mistake</div>
      <ul>
        <li><b>Mutating state directly</b> (<code>items.push(x)</code>, <code>user.name = "new"</code>) instead of calling the setter with a new array or object. The screen silently fails to update, with no error to point you at the cause.</li>
      </ul>
    </div>

    <div class="further">
      <div class="further-label">Go deeper</div>
      <ul>
        <li><a href="https://react.dev/learn/state-a-components-memory" target="_blank" rel="noopener">React docs: State: A Component's Memory</a></li>
        <li><a href="https://react.dev/reference/react/useState" target="_blank" rel="noopener">React docs: useState reference</a></li>
      </ul>
    </div>
  </section>

  <section class="chapter" id="lists-keys">
    <div class="chapter-num">Chapter 05</div>
    <h2>Rendering lists &amp; the key prop</h2>
    <p>Turning an array of data into an array of elements is just <code>.map()</code> — the same array method from plain JavaScript, now returning JSX instead of strings or numbers:</p>
    <CodeBlock code={listCode} lang="tsx" />

    <p>That <code>key={'{note.id}'}</code> attribute isn't optional decoration — React requires a <code>key</code> on every item produced inside a loop, and skipping it prints a console warning.</p>

    <h3>Why React needs it</h3>
    <CodeBlock code={keyWhyCode} lang="tsx" />

    <div class="plain">
      <div class="plain-label">In plain English</div>
      <p>Imagine reordering a list of sticky notes. If they're all blank, you can't tell which is which — you'd have to assume position #1 is still "the first note." A <code>key</code> is the label on each sticky note that lets React actually recognize "oh, this specific note moved from position 3 to position 1," instead of guessing from position alone.</p>
    </div>

    <div class="tryit">
      <div class="tryit-label">✳ Try it yourself</div>
      <p>In the <code>NoteList</code> example, think through what would happen if you used the array index as the key instead of <code>note.id</code>, and then deleted the first note in the list: every remaining note would shift up one index, so React would think item positions changed identity — not that one item was removed.</p>
    </div>

    <div class="further">
      <div class="further-label">Go deeper</div>
      <ul>
        <li><a href="https://react.dev/learn/rendering-lists" target="_blank" rel="noopener">React docs: Rendering Lists</a> — covers <code>key</code> in depth, including why the index is usually the wrong choice</li>
      </ul>
    </div>
  </section>

  <section class="chapter" id="events-forms">
    <div class="chapter-num">Chapter 06</div>
    <h2>Events &amp; forms</h2>
    <p>Event handlers in JSX look like HTML's <code>onclick</code>, but camelCased and passed a real function instead of a string:</p>
    <CodeBlock code={formCode} lang="tsx" />

    <p>Two details worth slowing down on:</p>
    <ul>
      <li>The <code>e: React.FormEvent</code> annotation types the event object the handler receives — it's one of the built-in TypeScript types that ship with React itself, so you get autocomplete on <code>e</code> without writing the type by hand. <code>e.preventDefault()</code> stops the browser's default behavior — for a form, that default is a full-page reload/navigation, which would blow away all your React state.</li>
      <li>The input's <code>value</code> comes from state, and <code>onChange</code> writes every keystroke back into that same state. This pairing is called a <strong>controlled input</strong>.</li>
    </ul>
    <CodeBlock code={controlledExplainCode} lang="js" />

    <div class="mistakes">
      <div class="mistakes-label">Common mistake</div>
      <ul>
        <li><b>Setting <code>value</code> without <code>onChange</code>.</b> React will render the input, then refuse to let you type in it — the box appears "frozen" on its initial value, because nothing is ever writing your keystrokes back into state.</li>
      </ul>
    </div>

    <div class="further">
      <div class="further-label">Go deeper</div>
      <ul>
        <li><a href="https://react.dev/learn/responding-to-events" target="_blank" rel="noopener">React docs: Responding to Events</a></li>
        <li><a href="https://react.dev/reference/react-dom/components/input" target="_blank" rel="noopener">React docs: &lt;input&gt; (controlled vs. uncontrolled)</a></li>
      </ul>
    </div>
  </section>

  <section class="chapter" id="effects">
    <div class="chapter-num">Chapter 07</div>
    <h2>Effects: reaching outside React</h2>
    <p>Everything so far happens inside React's own world: state changes, JSX re-renders. But real apps need to talk to things outside that world too — fetch data from an API, set a page title, start a timer. That's what <code>useEffect</code> is for:</p>
    <CodeBlock code={effectBasicCode} lang="tsx" />

    <p>The function you pass runs <em>after</em> React updates the screen, not during. The second argument — the <strong>dependency array</strong> — controls how often it re-runs:</p>
    <CodeBlock code={effectDepsCode} lang="tsx" />

    <div class="plain">
      <div class="plain-label">In plain English</div>
      <p>Read the dependency array as "re-run this effect whenever any of these values changes since last time." An empty array, <code>[]</code>, means "these values never change" — so it only runs once, right after the component first appears.</p>
    </div>

    <div class="mistakes">
      <div class="mistakes-label">Common mistake</div>
      <ul>
        <li><b>Forgetting the dependency array entirely.</b> Without it, the effect re-runs after every single render — including renders <em>caused by</em> the effect itself, which can spiral into an infinite loop of fetches.</li>
      </ul>
    </div>

    <div class="tryit">
      <div class="tryit-label">✳ Where this shows up</div>
      <p>In the app template covered in <a href={withBase("/crash-courses/react-router-7")}>React Router 7</a>, most data fetching actually happens in a <strong>loader</strong> before the component even renders — not in a <code>useEffect</code>. You'll still reach for <code>useEffect</code> for things a loader can't do: reacting to a prop changing after the page already loaded, or talking to a browser-only API.</p>
    </div>

    <div class="further">
      <div class="further-label">Go deeper</div>
      <ul>
        <li><a href="https://react.dev/learn/synchronizing-with-effects" target="_blank" rel="noopener">React docs: Synchronizing with Effects</a></li>
        <li><a href="https://react.dev/learn/you-might-not-need-an-effect" target="_blank" rel="noopener">React docs: You Might Not Need an Effect</a></li>
      </ul>
    </div>
  </section>

  <section class="chapter" id="putting-together">
    <div class="chapter-num">Chapter 08</div>
    <h2>Putting it together</h2>
    <p>Every idea from this course fits into one small, real component — a notes widget with add and remove:</p>
    <CodeBlock code={fullFeatureCode} lang="tsx" title="NotesWidget.tsx" />

    <p>Read it slowly and you should be able to name every piece: two pieces of <strong>state</strong> (<code>notes</code>, <code>draft</code>), a <strong>controlled form</strong>, a list built with <code>.map()</code> carrying a stable <strong>key</strong>, and two event handlers that call setters instead of ever touching the DOM directly.</p>

    <div class="plain">
      <div class="plain-label">In plain English</div>
      <p>This is roughly the same shape as the Notes feature built by hand in <a href={withBase("/getting-started")}>Getting Started</a> — except that version also saves to a real database with Prisma instead of just component state. Once you've read <a href={withBase("/crash-courses/prisma")}>Prisma</a>, come back and compare the two.</p>
    </div>

    <div class="tryit">
      <div class="tryit-label">✳ Where to go next</div>
      <p>Move on to <a href={withBase("/crash-courses/react-router-7")}>React Router 7</a> to see how a real page gets its initial data — the piece that sits just outside everything covered here.</p>
    </div>

    <div class="further">
      <div class="further-label">Go deeper</div>
      <ul>
        <li><a href="https://react.dev/learn" target="_blank" rel="noopener">React docs: Learn React</a> — the full guide, if you want more than a crash course</li>
        <li><a href="https://react.dev/reference/react" target="_blank" rel="noopener">React docs: API Reference</a></li>
      </ul>
    </div>
  </section>
</CourseLayout>
