---
import CourseLayout from '../../layouts/CourseLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { withBase } from '../../lib/url';

const chapters = [
  { id: 'why-toml', title: 'Why TOML, and where it shows up' },
  { id: 'basic-syntax', title: 'Basic syntax: keys, values, comments' },
  { id: 'tables', title: 'Tables: TOML’s version of nested objects' },
  { id: 'reading-real-file', title: 'Reading a real shopify.app.toml' },
];

const jsonVsTomlCode = `// The exact same data, as JSON...
{
  "name": "my-app",
  "client_id": "a1b2c3d4",
  "access_scopes": {
    "scopes": "read_products,write_orders"
  }
}

# ...and as TOML. No braces, no trailing-comma rules, no quoting
# every single key — designed specifically to be a config file a
# human edits by hand, not a data format a program generates:
name = "my-app"
client_id = "a1b2c3d4"

[access_scopes]
scopes = "read_products,write_orders"`;

const basicKvCode = `# A comment starts with # and runs to the end of the line —
# TOML's only comment syntax, no /* */ block comments.

name = "my-shopify-app"        # a string — double-quoted
client_id = "a1b2c3d4e5f6"     # also a string
embedded = true                # a boolean — lowercase, unquoted
scopes_count = 3                # a number — unquoted
webhook_api_version = "2025-01" # a string, even though it looks numeric —
                                 # quoted because it's meant as exact text,
                                 # not a value to do math on`;

const arrayCode = `# A TOML array — square brackets, comma-separated, same idea as a
# JS array. Can span multiple lines for readability:
topics = ["orders/create", "orders/updated", "app/uninstalled"]

# or, equivalently:
topics = [
  "orders/create",
  "orders/updated",
  "app/uninstalled",
]
# The trailing comma after the last item is optional (and fine to
# include) — unlike some languages, TOML doesn't error on it.`;

const tableBasicCode = `# A line like [access_scopes] starts a TABLE — every key=value
# line AFTER it, until the next [section] header, belongs to it.
# This is TOML's equivalent of a nested JS object:

[access_scopes]
scopes = "read_products,write_orders"

# ...is the same nesting as this JS object:
# { access_scopes: { scopes: "read_products,write_orders" } }`;

const nestedTableCode = `# A dot in the table name nests it one level deeper — build.automation
# is a table INSIDE another table called build:
[build]
automatically_update_urls_on_dev = true

[build.automation]
enabled = false
# ...is the same nesting as:
# { build: { automatically_update_urls_on_dev: true,
#            automation: { enabled: false } } }`;

const arrayOfTablesCode = `# Double square brackets — [[ ]] — mean something different from
# single brackets: EACH occurrence adds a new entry to an ARRAY of
# tables, rather than opening one single table. This is the syntax
# behind multiple webhook subscriptions in shopify.app.toml:

[[webhooks.subscriptions]]
topics = ["orders/create"]
uri = "/webhooks/orders/create"

[[webhooks.subscriptions]]
topics = ["app/uninstalled"]
uri = "/webhooks/app/uninstalled"

# ...is the same shape as this JS array of objects:
# {
#   webhooks: {
#     subscriptions: [
#       { topics: ["orders/create"], uri: "/webhooks/orders/create" },
#       { topics: ["app/uninstalled"], uri: "/webhooks/app/uninstalled" },
#     ]
#   }
# }
# Every [[webhooks.subscriptions]] line you add is another object
# pushed onto that same array — not a new, separate thing.`;

const fullFileCode = `# shopify.app.toml — generated by "shopify app init", edited by
# you as your app's needs change (see Getting Started, Step 2).

name = "my-shopify-app"
client_id = "a1b2c3d4e5f6"       # this app's identity on Shopify's side —
                                   # see the OAuth chapter of How Shopify
                                   # Apps Work for what this is used for
application_url = "https://my-app.example.com"
embedded = true

[access_scopes]
# Every permission this app requests — see the Scopes chapter of
# How Shopify Apps Work for what the merchant sees for this list.
scopes = "read_products,write_orders,read_customers"

[auth]
redirect_urls = ["https://my-app.example.com/auth/callback"]

[webhooks]
api_version = "2025-01"

[[webhooks.subscriptions]]
topics = ["orders/create"]
uri = "/webhooks/orders/create"

[[webhooks.subscriptions]]
# Shopify requires these three specific compliance webhooks on
# every public app — covered in How Shopify Apps Work's webhooks
# chapter:
topics = ["customers/data_request", "customers/redact", "shop/redact"]
uri = "/webhooks/compliance"

[build]
automatically_update_urls_on_dev = true`;
---
<CourseLayout
  title="TOML Quick Reference — Shopify App Handbook"
  description="Why shopify.app.toml uses TOML instead of JSON, TOML's basic syntax (keys, values, comments, arrays), how [tables] and the [[double-bracket]] array-of-tables syntax map to nested objects and arrays, and a full real shopify.app.toml read line by line."
  accent="blue"
  courseTitle="TOML"
  courseTagline="The config file format behind shopify.app.toml — one of the very first files 'shopify app init' generates, and one you'll edit by hand every time your app's scopes, webhooks, or URLs change."
  readTime="12–18 min"
  kind="Quick Reference"
  chapters={chapters}
  prev={{ href: '/crash-courses/eslint', title: 'ESLint' }}
>
  <section class="chapter" id="why-toml">
    <div class="chapter-num">Reference</div>
    <h2>Why TOML, and where it shows up</h2>
    <p><strong>TOML</strong> (Tom's Obvious, Minimal Language) is a config-file format designed to be edited by hand comfortably — no trailing-comma errors, no quoting every key, real comments. The exact same data, compared to the JSON format used elsewhere on this site (Prisma's generated SQL, package.json):</p>
    <CodeBlock code={jsonVsTomlCode} lang="toml" />

    <p>On this site, TOML appears in exactly one place that matters: <code>shopify.app.toml</code>, generated by <code>shopify app init</code> (see <a href={withBase("/getting-started")}>Getting Started</a>) and referenced throughout <a href={withBase("/crash-courses/how-shopify-apps-work")}>How Shopify Apps Work</a> for scopes and webhook configuration.</p>

    <div class="plain">
      <div class="plain-label">In plain English</div>
      <p>JSON was designed first and foremost for programs to write and parse quickly. TOML was designed for a person to open in a text editor, understand at a glance, and edit correctly without a syntax reference open in another tab — which is exactly the job a file you're expected to hand-edit (like your app's scopes) needs to do well.</p>
    </div>

    <div class="recap">
      <div class="recap-label">Recap</div>
      <ul>
        <li>TOML is a human-editable config format — comments, no fussy comma rules, minimal quoting.</li>
        <li>On this site it appears specifically in <code>shopify.app.toml</code>, generated by the CLI and edited by hand as your app's needs change.</li>
      </ul>
    </div>

    <div class="further">
      <div class="further-label">Go deeper</div>
      <ul>
        <li><a href="https://toml.io/en/" target="_blank" rel="noopener">toml.io — the official spec, in plain language</a></li>
      </ul>
    </div>
  </section>

  <section class="chapter" id="basic-syntax">
    <div class="chapter-num">Reference</div>
    <h2>Basic syntax: keys, values, comments</h2>
    <p>Every line is either a comment, blank, or a <code>key = value</code> pair:</p>
    <CodeBlock code={basicKvCode} lang="toml" />

    <p>An array is square-bracketed and comma-separated, and can span multiple lines:</p>
    <CodeBlock code={arrayCode} lang="toml" />

    <div class="mistakes">
      <div class="mistakes-label">Common mistake</div>
      <ul>
        <li><b>Leaving a value that looks numeric unquoted when it's meant as exact text.</b> A version string like <code>"2025-01"</code> needs its quotes — unquoted, TOML would try to read it as a number (and likely error, since it isn't a valid one) instead of the literal text you meant.</li>
      </ul>
    </div>

    <div class="recap">
      <div class="recap-label">Recap</div>
      <ul>
        <li><code>#</code> starts a comment; strings are double-quoted; booleans and numbers are unquoted.</li>
        <li>Arrays use square brackets, comma-separated, and can be multi-line for readability.</li>
      </ul>
    </div>

    <div class="further">
      <div class="further-label">Go deeper</div>
      <ul>
        <li><a href="https://toml.io/en/v1.0.0#string" target="_blank" rel="noopener">TOML spec — strings, numbers &amp; arrays</a></li>
      </ul>
    </div>
  </section>

  <section class="chapter" id="tables">
    <div class="chapter-num">Reference</div>
    <h2>Tables: TOML's version of nested objects</h2>
    <p>A line like <code>[access_scopes]</code> is a <strong>table header</strong> — every <code>key = value</code> line after it, until the next header, belongs to it. This is TOML's way of nesting, equivalent to a nested object in JSON or JavaScript:</p>
    <CodeBlock code={tableBasicCode} lang="toml" />

    <p>A dot in the table name nests one level deeper:</p>
    <CodeBlock code={nestedTableCode} lang="toml" />

    <p>Double square brackets — <code>[[ ]]</code> — mean something different from a single-bracket table: each occurrence appends a new entry to an <strong>array of tables</strong>, rather than opening one fixed section. This is exactly the syntax behind multiple webhook subscriptions in <code>shopify.app.toml</code>:</p>
    <CodeBlock code={arrayOfTablesCode} lang="toml" />

    <div class="plain">
      <div class="plain-label">In plain English</div>
      <p>Single brackets say "here is one specific box, and everything below belongs inside it." Double brackets say "add one more item to this list of boxes" — every time you write <code>[[webhooks.subscriptions]]</code> again, you're not overwriting the previous one, you're adding another entry right alongside it.</p>
    </div>

    <div class="mistakes">
      <div class="mistakes-label">Common mistake</div>
      <ul>
        <li><b>Using a single bracket where a double bracket was needed (or vice versa).</b> <code>[webhooks.subscriptions]</code> (single) would try to define one fixed table named that; <code>[[webhooks.subscriptions]]</code> (double) adds another item to a list. Needing more than one webhook subscription is exactly when this distinction matters.</li>
      </ul>
    </div>

    <div class="recap">
      <div class="recap-label">Recap</div>
      <ul>
        <li><code>[table]</code> opens a nested section — TOML's equivalent of a nested object.</li>
        <li><code>[[table]]</code> (double brackets) appends a new entry to an array of tables — used for <code>shopify.app.toml</code>'s repeatable webhook subscriptions.</li>
      </ul>
    </div>

    <div class="further">
      <div class="further-label">Go deeper</div>
      <ul>
        <li><a href="https://toml.io/en/v1.0.0#array-of-tables" target="_blank" rel="noopener">TOML spec — array of tables</a></li>
      </ul>
    </div>
  </section>

  <section class="chapter" id="reading-real-file">
    <div class="chapter-num">Reference</div>
    <h2>Reading a real shopify.app.toml</h2>
    <p>Everything above is enough to read the actual file the CLI generates, and every edit Getting Started and How Shopify Apps Work reference (scopes, webhook subscriptions, the app URL):</p>
    <CodeBlock code={fullFileCode} lang="toml" title="shopify.app.toml" />

    <div class="tryit">
      <div class="tryit-label">✳ Try it yourself</div>
      <p>Open the real <code>shopify.app.toml</code> from a project scaffolded with <code>shopify app init</code> and match every line against this reference before changing anything — the concepts above (client_id, access_scopes, webhooks) are explained conceptually in <a href={withBase("/crash-courses/how-shopify-apps-work")}>How Shopify Apps Work</a>; this page is only about the file <em>format</em> they're written in.</p>
    </div>

    <div class="recap">
      <div class="recap-label">Recap</div>
      <ul>
        <li>A real <code>shopify.app.toml</code> combines everything from this reference: top-level keys, single-bracket tables (<code>[access_scopes]</code>, <code>[auth]</code>), and double-bracket arrays of tables (<code>[[webhooks.subscriptions]]</code>) for anything repeatable.</li>
      </ul>
    </div>

    <div class="tryit">
      <div class="tryit-label">✳ You've reached the end of the quick references</div>
      <p>That's every planned short reference for now. For the full technical courses, head back to the <a href={withBase("/crash-courses")}>Crash Courses hub</a> — or continue building in <a href={withBase("/getting-started")}>Getting Started</a>.</p>
    </div>
  </section>
</CourseLayout>
