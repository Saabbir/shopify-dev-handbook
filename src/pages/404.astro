---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---
<BaseLayout
  title="Page not found — Shopify App Handbook"
  description="This page doesn't exist."
  accent="gold"
>
  <header>
    <h1 class="page-title">404 — Page not found</h1>
    <p class="lede">That page doesn't exist, or it moved. Try one of the links above, or head back to the <a href={withBase("/")}>home page</a>.</p>
  </header>
</BaseLayout>
