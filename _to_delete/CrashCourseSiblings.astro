---
interface Props {
  current: string;
}
const { current } = Astro.props;

const ALL = [
  { key: 'typescript', title: 'TypeScript', href: '/crash-courses/typescript' },
  { key: 'react', title: 'React', href: '/crash-courses/react' },
  { key: 'graphql', title: 'GraphQL', href: '/crash-courses/graphql' },
  { key: 'node', title: 'Node.js', href: '/crash-courses/node' },
  { key: 'prisma', title: 'Prisma', href: '/crash-courses/prisma' },
  { key: 'reactrouter', title: 'React Router 7', href: '/crash-courses/react-router-7' },
];

const siblings = ALL.filter((t) => t.key !== current);
---
<div class="siblings">
  <span class="label">More crash courses:</span>
  {siblings.map((s) => <a href={s.href}>{s.title}</a>)}
</div>
<footer class="sitefooter">Crash courses cover the 20% that gets used 80% of the time — for everything else, the official docs linked under "Learn more" are the next stop, and the <a href="/roadmap">full Roadmap</a> covers each topic in far more depth.</footer>
